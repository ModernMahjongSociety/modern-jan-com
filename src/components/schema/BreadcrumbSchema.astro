---
import { SITE_URL, toSafeJsonLd } from '../../lib/schema';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    ...(item.href ? { "item": new URL(item.href, SITE_URL).toString() } : {}),
  })),
};

const safeJsonLd = toSafeJsonLd(schema);
---

<script type="application/ld+json" set:html={safeJsonLd} />
