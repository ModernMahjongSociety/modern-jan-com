---
interface Props {
  title: string;
  description?: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  image: string;
  url: string;
}

const { title, description, publishedAt, updatedAt, tags, image, url } = Astro.props;
const siteUrl = (import.meta.env.SITE || 'https://modern-jan.com').replace(/\/$/, '');

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description || "麻雀の戦術・技術について研究するサークル",
  "image": image,
  "datePublished": publishedAt.toISOString(),
  ...(updatedAt && updatedAt > publishedAt ? { "dateModified": updatedAt.toISOString() } : {}),
  "url": url,
  "inLanguage": "ja",
  "author": {
    "@type": "Organization",
    "name": "モダンジャン研究会",
    "url": siteUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "モダンジャン研究会",
    "url": siteUrl,
  },
  ...(tags.length > 0 ? { "keywords": tags.join(", ") } : {}),
};

const safeJsonLd = JSON.stringify(schema)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<script type="application/ld+json" set:html={safeJsonLd} />
