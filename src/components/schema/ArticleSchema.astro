---
import { SITE_DESCRIPTION, getSiteUrl, getOrganization, toSafeJsonLd } from '../../lib/schema';

interface Props {
  title: string;
  description?: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  image: string;
  url: string;
}

const { title, description, publishedAt, updatedAt, tags, image, url } = Astro.props;
const siteUrl = getSiteUrl();
const organization = getOrganization(siteUrl);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description || SITE_DESCRIPTION,
  "image": image,
  "datePublished": publishedAt.toISOString(),
  ...(updatedAt && updatedAt > publishedAt ? { "dateModified": updatedAt.toISOString() } : {}),
  "url": url,
  "inLanguage": "ja",
  "author": organization,
  "publisher": organization,
  ...(tags.length > 0 ? { "keywords": tags.join(", ") } : {}),
};

const safeJsonLd = toSafeJsonLd(schema);
---

<script type="application/ld+json" set:html={safeJsonLd} />
