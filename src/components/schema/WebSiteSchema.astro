---
import { SITE_NAME, SITE_DESCRIPTION, getSiteUrl, getOrganization, toSafeJsonLd } from '../../lib/schema';

const siteUrl = getSiteUrl();

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": siteUrl,
  "description": SITE_DESCRIPTION,
  "inLanguage": "ja",
  "publisher": getOrganization(siteUrl),
};

const safeJsonLd = toSafeJsonLd(schema);
---

<script type="application/ld+json" set:html={safeJsonLd} />
