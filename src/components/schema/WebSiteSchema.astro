---
const siteUrl = (import.meta.env.SITE || 'https://modern-jan.com').replace(/\/$/, '');

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "モダンジャン研究会",
  "url": siteUrl,
  "description": "麻雀の戦術・技術について研究するサークル",
  "inLanguage": "ja",
  "publisher": {
    "@type": "Organization",
    "name": "モダンジャン研究会",
    "url": siteUrl,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
