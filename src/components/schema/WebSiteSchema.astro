---
const siteUrl = (import.meta.env.SITE || 'https://modern-jan.com').replace(/\/$/, '');

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "モダンジャン研究会",
  "url": siteUrl,
  "description": "麻雀の戦術・技術について研究するサークル",
  "inLanguage": "ja",
  "publisher": {
    "@type": "Organization",
    "name": "モダンジャン研究会",
    "url": siteUrl,
  },
};

const safeJsonLd = JSON.stringify(schema)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<script type="application/ld+json" set:html={safeJsonLd} />
