---
import { getSiteUrl, toSafeJsonLd } from '../../lib/schema';

const siteUrl = getSiteUrl();

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "モダンジャン研究会",
  "url": siteUrl,
  "description": "麻雀の戦術・技術について研究するサークル",
  "inLanguage": "ja",
  "publisher": {
    "@type": "Organization",
    "name": "モダンジャン研究会",
    "url": siteUrl,
  },
};

const safeJsonLd = toSafeJsonLd(schema);
---

<script type="application/ld+json" set:html={safeJsonLd} />
