---
import '../styles/global.css';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  noindex?: boolean;
}

const { title, description, ogImage, ogType = 'website', publishedAt, updatedAt, tags, noindex } = Astro.props;
const fullTitle = `${title} | ${SITE_NAME}`;

// デフォルトOGP画像（SSG生成）
const defaultOgImage = `${Astro.site}ogp/default.png`;

const ogImageUrl = ogImage || defaultOgImage;
const descriptionContent = description || SITE_DESCRIPTION;
const canonicalUrl = Astro.url.href;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={descriptionContent} />
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <link rel="canonical" href={canonicalUrl} />
  )}

  <!-- OGP -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={descriptionContent} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="ja_JP" />
  {ogType === 'article' && publishedAt && (
    <meta property="article:published_time" content={publishedAt.toISOString()} />
  )}
  {ogType === 'article' && updatedAt && publishedAt && updatedAt > publishedAt && (
    <meta property="article:modified_time" content={updatedAt.toISOString()} />
  )}
  {ogType === 'article' && tags?.map(tag => (
    <meta property="article:tag" content={tag} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={descriptionContent} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />

  <!-- Preconnect to external domains for faster resource loading -->
  <link rel="preconnect" href="https://r2.modern-jan.com" crossorigin />
  <link rel="dns-prefetch" href="https://r2.modern-jan.com" />

  <!-- Service Worker登録 -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(registration => {
            console.log('Service Worker registered:', registration.scope);
          })
          .catch(error => {
            console.log('Service Worker registration failed:', error);
          });
      });
    }
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">コンテンツへスキップ</a>
  <slot />
</body>
</html>
